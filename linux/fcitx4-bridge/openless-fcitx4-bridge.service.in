[Unit]
Description=OpenLess compatibility bridge for Fcitx 4 and Sogou
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=org.fcitx.Fcitx5
ExecStart=@PREFIX@/venv/bin/python -u @PREFIX@/openless_fcitx4_bridge.py
Restart=on-failure
RestartSec=1
TimeoutStopSec=3
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/OpenLess

[Install]
WantedBy=default.target
